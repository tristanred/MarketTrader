    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Share of measurements the web-vitals library itself rated 'good'. The rating is exact rather than bucket-approximated, which makes this the most trustworthy view on the board. One target per vital: a single selector across all five cannot work, because rate() drops __name__ and the five would collapse into identical label sets.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "max": 1,
          "min": 0,
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
