    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Largest Contentful Paint, p75. Thresholds are Google's: good < 2.5s, poor > 4s. Bucket boundaries are the SDK defaults, so this value snaps to edges like 2500 and 5000 rather than moving smoothly \u2014 a stepped line is expected, not a bug. Cumulative since the server started, so it only ratchets upward \u2014 one slow cold start pins it for the life of the process. Colour is deliberately neutral here; 'Share rated good' is the signal that recovers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le) (max_over_time(markettrader_web_vitals_lcp_milliseconds_bucket{service_name=\"$service\"}[$__range])))",
          "legendFormat": "LCP",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "LCP (p75)",
      "type": "stat"
    },
