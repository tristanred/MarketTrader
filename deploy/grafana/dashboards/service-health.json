    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Milliseconds \u2014 application histograms use ms, unlike the span-metrics and undici panels which are in seconds.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
