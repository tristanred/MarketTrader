      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Filled trades, from both the trade endpoint and the settlement worker. This is a running total since the process started, not a count within the time range: metrics export every 60s, so increase() cannot see a counter's first sample and reports 0 for anything that happened once. The trade-off is restarts \u2014 across one, max_over_time holds the pre-restart peak until the new run exceeds it, so the number reads stale-high rather than dropping to zero.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(max_over_time(markettrader_trades_executed_total{service_name=\"$service\"}[$__range]))",
          "instant": true,
          "legendFormat": "trades",
          "range": false,
          "refId": "A"
        }
