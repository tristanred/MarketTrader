[Unit]
Description=MarketTrader SQLite backup snapshot
Documentation=https://github.com/tristanred/MarketTrader
After=markettrader.service

[Service]
Type=oneshot
User=markettrader
Group=markettrader
EnvironmentFile=/etc/markettrader/env
ExecStart=/opt/markettrader/deploy/backup.sh hourly

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Needs read access to the live DB (and write access for the WAL) plus the
# backup tree it writes snapshots into.
ReadWritePaths=/var/lib/markettrader /var/backups/markettrader

StandardOutput=journal
StandardError=journal
SyslogIdentifier=markettrader-backup
