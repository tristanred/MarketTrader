[Unit]
Description=Hourly MarketTrader SQLite backup
Documentation=https://github.com/tristanred/MarketTrader

[Timer]
OnCalendar=hourly
# The VM is expected to lose power occasionally; run a catch-up snapshot on
# boot if the machine was off when a run was due.
Persistent=true
# Avoid every timer on the box firing at :00 simultaneously.
RandomizedDelaySec=120
Unit=markettrader-backup.service

[Install]
WantedBy=timers.target
