[Unit]
Description=MarketTrader API server
Documentation=https://github.com/tristanred/MarketTrader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=markettrader
Group=markettrader
WorkingDirectory=/opt/markettrader/packages/server
EnvironmentFile=/etc/markettrader/env
ExecStart=/usr/bin/node dist/index.js

# The app installs SIGTERM handlers and drains WS clients before exiting
# (packages/server/src/index.ts). Give it room to finish, then force the issue.
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=always
RestartSec=5
# Don't spin forever on a config error that can never succeed — a bad
# JWT_SECRET or DATABASE_URL throws at boot every single time.
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening. ProtectSystem=strict makes the whole filesystem read-only, so
# every path the process writes to must be listed explicitly below.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK is not optional despite the app never opening a netlink socket
# itself: glibc's getifaddrs() enumerates interfaces over netlink, and Fastify
# calls os.networkInterfaces() to log the bound address immediately after
# listen(). Without it the process binds the port and then dies with
# "uv_interface_addresses returned Unknown system error 97" (EAFNOSUPPORT).
# glibc's resolver also uses netlink for AI_ADDRCONFIG, so outbound DNS —
# every stock-price fetch — depends on it too.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/markettrader

StandardOutput=journal
StandardError=journal
SyslogIdentifier=markettrader

[Install]
WantedBy=multi-user.target
