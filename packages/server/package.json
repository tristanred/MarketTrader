    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^4.0.2",
    "nyse-holidays": "^1.2.0",
    "pino-opentelemetry-transport": "^4.0.2",
    "postgres": "^3.4.9",
    "yahoo-finance2": "^3.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
